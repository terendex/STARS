Port 22
Banner /etc/ssh/banner.txt

# Players log in with the password from the challenge description.
AllowGroups players
PermitRootLogin no
PasswordAuthentication yes
PubkeyAuthentication no
KbdInteractiveAuthentication no
UsePAM no
PermitEmptyPasswords no
MaxAuthTries 6
LoginGraceTime 30
# Players all arrive through the edge proxy, so sshd sees them as one address.
# With penalties on, one player's mistyped passwords lock out everyone.
PerSourcePenalties no

# Shell only: no tunnels, so the box can't be used as a way into anything else.
AllowTcpForwarding no
AllowStreamLocalForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
PermitUserRC no

PrintMotd no
PrintLastLog no
MaxSessions 4
# A whole class can be sitting at the password prompt at the same time.
MaxStartups 100:30:200
ClientAliveInterval 60
ClientAliveCountMax 5
