# scripts/setup.ps1 (Windows) or scripts/setup.sh (Linux) makes .env for you,
# with random values. This file only shows what goes in it.

# The address ports are published on. Setup keeps it at 127.0.0.1 until CTFd's
# admin account is claimed, because the first visitor to /setup becomes admin,
# then set-host moves it to this PC's network address.
CTF_BIND_IP=127.0.0.1

SECRET_KEY=change-me
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
